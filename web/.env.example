# fixtures = the SYNTHETIC data in src/fixtures, api = the local backend. Unset: api if a launch token is present, else fixtures.
VITE_DATA_SOURCE=fixtures
VITE_API_BASE=http://127.0.0.1:8000
# Leave VITE_API_BASE empty for a build the API serves same-origin. The launcher passes the token as #t=...
# The backend prints a per-launch token at startup. Paste it here (in .env.local, never committed).
VITE_VITRA_TOKEN=
